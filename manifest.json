{
  "manifest_version": 3,
  "name": "ChatGPT to Obsidian Markdown",
  "description": "Export the current ChatGPT conversation as Obsidian-friendly Markdown.",
  "version": "0.1.2",
  "action": {
    "default_popup": "popup.html",
    "default_title": "Export to Obsidian"
  },
  "permissions": ["activeTab", "downloads", "scripting", "storage"],
  "host_permissions": ["https://chatgpt.com/*"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://chatgpt.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
